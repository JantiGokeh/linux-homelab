    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "url": "https://www.googleapis.com/calendar/v3/calendars/YOUR_URL_ENCODED_CALENDAR_ID/events",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "timeMin",
              "value": "={{ $now.setZone('America/New_York').startOf('day').plus({ days: Number($('Val Calendar Webhook').item.json.body.start_offset_days || 0) }).toISO() }}"
            },
            {
              "name": "timeMax",
              "value": "={{ $now.setZone('America/New_York').startOf('day').plus({ days: Number($('Val Calendar Webhook').item.json.body.start_offset_days || 0) + Number($('Val Calendar Webhook').item.json.body.days || 1) }).toISO() }}"
            },
            {"name": "singleEvents", "value": "true"},
            {"name": "orderBy", "value": "startTime"},
            {"name": "maxResults", "value": "50"},
            {"name": "timeZone", "value": "America/New_York"}
          ]
        }
      },
      "id": "407fa052-ab47-4ce2-905c-267247f81c80",
      "name": "Get Calendar Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "credentials": {}
    },
    {
      "parameters": {
        "jsCode": "const body = $('Val Calendar Webhook').first().json.body || {};\nconst startOffsetDays = Number(body.start_offset_days || 0);\nconst days = Number(body.days || 1);\nconst events = ($json.items || []).map(event => ({\n  summary: event.summary || 'Untitled event',\n  start: event.start?.dateTime || event.start?.date || null,\n  end: event.end?.dateTime || event.end?.date || null,\n  all_day: Boolean(event.start?.date && !event.start?.dateTime),\n  location: event.location || null,\n  description: event.description || null,\n  status: event.status || null\n}));\nreturn [{ json: { ok: true, timezone: 'America/New_York', start_offset_days: startOffsetDays, days, count: events.length, events } }];"
      },
      "id": "47700102-5d4d-4758-a38c-e1b7af7b5c54",
      "name": "Format Calendar Result",
